# Copy to .env and adjust. Never commit .env.

# PostgreSQL (POS source system)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=najm_pos
POSTGRES_USER=najm
POSTGRES_PASSWORD=najm_local_pw

# Online store mock API
MOCK_API_PORT=8000
MOCK_API_BASE_URL=http://127.0.0.1:8000

# Generator
GEN_OUTPUT_DIR=./data/landing
GEN_SEED=42

# Local dev warehouse
DUCKDB_PATH=./data/warehouse/najm_dev.duckdb
